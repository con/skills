{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed STAMPED assessment",
  "type": "object",
  "required": ["checklist_version", "schema_version", "principles_version", "checklist_source", "object", "assessor", "scope", "responses"],
  "properties": {
    "checklist_version": {"type": "string"},
    "schema_version": {"type": "string"},
    "principles_version": {"type": "string"},
    "checklist_source": {
      "type": "object", "required": ["repo", "tag", "commit"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "scope": {"type": "string", "minLength": 1},
    "object": {
      "type": "object", "required": ["commit", "captured_at", "kind"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "kind": {"enum": ["dataset", "component", "study", "skill"]},
        "url": {"type": ["string", "null"]}
      }
    },
    "assessor": {
      "type": "object", "required": ["skill", "version", "harness", "model", "date", "dependencies"],
      "properties": {
        "skill": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "dependencies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "responses": {"type": "object", "additionalProperties": {"$ref": "#/$defs/answer"}},
    "extra_items": {
      "type": "array", "items": {
        "type": "object", "required": ["key", "status", "reason", "evidence"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/status"},
          "reason": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  },
  "$defs": {
    "status": {"enum": ["met", "partial", "unmet", "not-checked", "not-applicable"]},
    "evidence": {
      "type": "array", "items": {
        "type": "object", "required": ["uri"],
        "properties": {
          "uri": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
        }
      }
    },
    "answer": {
      "type": "object", "required": ["status", "reason", "source"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reason": {"type": "string", "maxLength": 250},
        "source": {"type": "string", "minLength": 1},
        "value": {"enum": ["yes", "no", null]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "flags": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
